<!doctype html>
<html lang="zh-cn">

<head>
    <meta charset="utf-8" />
    <title>发票库</title>
    <link rel="stylesheet" href="/static/component/pear/css/pear.css" />
</head>

<body class="pear-container">
    <div class="layui-card">
        <div class="layui-card-body">
            <table id="invoice-table" lay-filter="invoice-table"></table>
        </div>
    </div>

    <script type="text/html" id="invoice-toolbar">
         <button class="pear-btn pear-btn-primary pear-btn-md" lay-event="add">
            <i class="layui-icon layui-icon-add-1"></i>
            新增发票
        </button>
    </script>

    <script src="/static/component/layui/layui.js"></script>
    <script src="/static/component/pear/pear.js"></script>
    <script>
        layui.use(['table', 'jquery'], function () {
            let table = layui.table;
            let $ = layui.jquery;
            let MODULE_PATH = "/api/v1/material/";

            table.render({
                elem: '#invoice-table',
                url: MODULE_PATH + 'invoice',
                toolbar: '#invoice-toolbar',
                defaultToolbar: ['filter', 'print', 'exports'],
                page: true,
                cols: [[
                    { type: 'checkbox' },
                    { field: 'invoice_number', title: '发票号' },
                    { field: 'buyer_name', title: '购买方' },
                    { field: 'seller_name', title: '销售方' },
                    { field: 'total_amount', title: '金额' },
                    { field: 'invoice_date', title: '日期' }
                ]]
            });

            table.on('toolbar(invoice-table)', function (obj) {
                if (obj.event === 'add') {
                    window.add();
                }});

            window.add = function () {
                layer.open({
                    type: 2,
                    title: '新增发票',
                    shade: 0.1,
                    area: ['500px', '550px'],
                    content: MODULE_PATH + 'invoice/add'
                });
            }})
    </script>
</body>

</html>